# Backend configuration. Copy to `.env` at the repo root; `npm run dev` and
# `npm run start` load it via `node --env-file=../.env`.

# ── Server basics ──────────────────────────────────────────────────────────
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173

# ── Multi-tenancy ──────────────────────────────────────────────────────────
# Supabase Auth + tenant resolution are always enforced on /api. Set ONE of:
#
#   SUPABASE_URL          Project URL (https://<ref>.supabase.co). Used for
#                         ES256/RS256 projects — tokens verified against the
#                         public JWKS. This is the current Supabase default.
#
#   SUPABASE_JWT_SECRET   Legacy HS256 shared secret (Project Settings → API →
#                         JWT Secret) ONLY for projects still on symmetric
#                         signing. Never the anon/sb_publishable_ key — it is
#                         public and would let clients forge tokens.
#
# At least one is REQUIRED — the server returns 503 on /api until set. If both
# are set, JWKS (asymmetric) is tried first, then the HS256 secret.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Master key for tenant-secret encryption. Generate with:
#   openssl rand -base64 32
# Per-tenant keys are derived via HKDF-SHA256 (info=tenant_secrets.v1).
SECRETS_MASTER_KEY=

# ── Break-glass admin (Supabase outage path) ───────────────────────────────
# All three required to use POST /admin/break-glass/login.
# Keep off in normal operation; flip on during an incident, then rotate
# ADMIN_TOTP_SECRET afterwards.
BREAK_GLASS_ENABLED=0
ADMIN_TOTP_SECRET=                 # base32, set up in an authenticator app
BREAK_GLASS_JWT_SECRET=            # independent HS256 secret (MUST differ from
                                   # SUPABASE_JWT_SECRET — boot fails otherwise)

# ── Platform operators (operator-only routes: /api/admin, /api/db) ─────────
# A signed-in user is `owner` of their own auto-provisioned tenant, so tenant
# role is NOT an operator signal. List the real operators explicitly. If both
# are empty, /api/admin and /api/db are denied to everyone (fail closed).
PLATFORM_OPERATOR_EMAILS=          # comma-separated, e.g. you@example.com
PLATFORM_OPERATOR_IDS=             # comma-separated Supabase user ids (optional)

# ── Upstream API keys (platform default; tenants can BYOK) ─────────────────
# Set only the ones you actually pay for. Free-tier sources work without.
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
WINDY_API_KEY=
GITHUB_TOKEN=
ODPT_TOKEN=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
GREYNOISE_API_KEY=
FOFA_API_KEY=
QUAKE_API_KEY=
EDINET_API_KEY=
HOTPEPPER_API_KEY=
OPENCELLID_KEY=
MARINETRAFFIC_API_KEY=
VESSELFINDER_API_KEY=
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
RESAS_API_KEY=
ESTAT_API_KEY=
GOOGLE_MYMAPS_IDS=
WIGLE_API_KEY=
MLS_API_KEY=
TWITTER_BEARER_TOKEN=
FACEBOOK_ACCESS_TOKEN=
MISSKEY_TOKEN=
UMISHIRU_API_KEY=
USGS_M2M_TOKEN=
AERODATABOX_KEY=
OPENCHARGEMAP_KEY=
GRAYHAT_API_KEY=
MLIT_N02_GEOJSON_URL=

# ── Billing (Stripe) ───────────────────────────────────────────────────────
# Optional. When STRIPE_SECRET_KEY is unset the entire billing surface
# no-ops: /api/billing/* returns 503, the subscription gate lets everyone
# through, and every tenant stays on the free plan. Set these to enable the
# self-serve signup → pay → access flow.
#
#   STRIPE_SECRET_KEY      sk_live_… / sk_test_…
#   STRIPE_WEBHOOK_SECRET  whsec_… — signing secret of the endpoint you point
#                          at POST /api/billing/webhook (Stripe Dashboard →
#                          Developers → Webhooks). Subscribe to:
#                          checkout.session.completed,
#                          customer.subscription.created/updated/deleted
#   STRIPE_PRICE_PRO / _TEAM / _ENTERPRISE
#                          price_… ids for each paid tier (recurring prices).
#                          Only the tiers with a price set are offerable.
#   BILLING_RETURN_URL     base URL Checkout/Portal return to, e.g.
#                          https://app.example.com (used for /billing?status=…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=
BILLING_RETURN_URL=

# ── LLM enrichment ─────────────────────────────────────────────────────────
LLM_VISION_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Single LLM runtime: local llama.cpp llama-server ───────────────────────
# Every LLM use (keyword/geocode/station-dedup enrichers, entity NER, the
# OSINT search pipeline) talks to one llama-server. Start it with
# `npm run dev:llama` (server/scripts/start-llama.sh). LLM_ENABLED gates the
# enrichment cron (opt-in: must be exactly "true").
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:8080
# Dedicated small-model llama-server for /api/search/suggest only, so typing
# suggestions never blocks (or is blocked by) the OSINT pipeline's 20B. If
# unset/empty the suggest path falls back to LLM_BASE_URL (no regression).
# launch.sh runs this pod (qwen2.5-1.5b) on :8081 by default.
LLM_SUGGEST_BASE_URL=http://localhost:8081
# Path to the tuned gpt-oss-20b GGUF (read by start-llama.sh). Search + LLM
# enrichers degrade gracefully when absent; entity graph still serves.
OSINT_MODEL_PATH=server/models/gpt-oss-20b-Q4_K_M.gguf
# Optional: explicit llama-server binary (else auto-detected).
LLAMA_BIN=

# ── Entity graph / OSINT search ────────────────────────────────────────────
OSINT_MAX_ROUNDS=5          # recursive follow-up rounds (OSINTsaas: 5)
ENTITY_BACKFILL_BATCH=50    # intel_items NER'd per 5-min enricher tick; raise
                            # for a faster one-off full-corpus backfill
ENTITY_RESOLVE_BATCH=40     # tier-2 LLM dedup adjudications per tick

# ── Additional collector keys (all OPTIONAL) ───────────────────────────────
# Referenced by individual collectors. Every one degrades gracefully when
# unset (the collector returns an empty result / skips that source), so the
# platform runs fine without them — set only the ones you have.
YOUTUBE_API_KEY=                   # cameraDiscovery.js — YouTube live-cam search
URLSCAN_API_KEY=                   # urlscanJp.js (free tier works unauthenticated)
GITLAB_TOKEN=                      # gitlabBitbucketLeaks.js (GitLab side)
BITBUCKET_TOKEN=                   # gitlabBitbucketLeaks.js (Bitbucket side)
DEHASHED_USER=                     # dehashedBreach.js — paired with DEHASHED_KEY
DEHASHED_KEY=                      # dehashedBreach.js
ESTAT_APP_ID=                      # eStatCrime.js / e-Stat app id
NASA_FIRMS_MAP_KEY=                # nasaFirmsJp.js (primary)
FIRMS_MAP_KEY=                     # nasaFirmsJp.js (fallback alias)
ODPT_CONSUMER_KEY=                 # odptTransport.js — paired with challenge token
ODPT_CHALLENGE_TOKEN=              # odptTransport.js (ODPT Challenge API)
TWITCH_CLIENT_ID=                  # twitchJpStreams.js — paired with secret
TWITCH_CLIENT_SECRET=              # twitchJpStreams.js
HOUJIN_BANGOU_KEY=                 # houjinBangou.js (corporate-number API)
PHISHTANK_APP_KEY=                 # phishingFeedsJp.js (PhishTank)
FOFA_EMAIL=                        # fofaJp.js (optional; has defaults)
BGPTOOLS_USER_AGENT=               # bgpToolsJp.js (contact UA; has a fallback)

# ── Batch 1/2 SaaS + OSINT collector keys (all OPTIONAL) ───────────────────
# Every collector below returns an honest empty result when its key is unset
# (and shows the "needs API key" badge in the iOS Sources tab). Set only what
# you have. ESTAT_APP_ID / SENTINELHUB_* / MARINETRAFFIC_API_KEY / WINDY_API_KEY
# / SHODAN_API_KEY are defined elsewhere in this file and reused.
FLICKR_API_KEY=                    # flickrGeo.js
TIKTOK_MS_TOKEN=                   # tiktokGeo.js
EIGHT_SESSION=                     # eightSansan.js (Eight account session cookie)
NAVITIME_API_KEY=                  # navitimeApi.js (RapidAPI key)
YAHOO_APP_ID=                      # yahooMapApi.js (Yahoo! Japan app id)
HERE_API_KEY=                      # hereJapan.js
REINFOLIB_API_KEY=                 # reinfolib.js (MLIT Real Estate Info Library)
TELLUS_TOKEN=                      # tellusSatellite.js
DOCOMO_POPULATION_API_KEY=         # docomoPopulation.js (paid contract API)
DOCOMO_INSIGHT_API_KEY=            # docomoInsight.js (paid contract API)
AGOOP_API_KEY=                     # agoopFlow.js (paid contract API)
SOFTBANK_CROWD_API_KEY=            # softbankCrowd.js (paid contract API)
MAPFAN_API_KEY=                    # mapfanApi.js
GOOGLE_CSE_KEY=                    # googleDorking.js — paired with GOOGLE_CSE_CX
GOOGLE_CSE_CX=                     # googleDorking.js (Programmable Search engine id)
SERPAPI_KEY=                       # googleDorking.js (alternative to Google CSE)
TGSTAT_API_KEY=                    # telegramJpChannels.js (TGStat API)
TELEGRAM_API_ID=                   # telegramJpChannels.js — paired with hash
TELEGRAM_API_HASH=                 # telegramJpChannels.js (MTProto)
INSTAGRAM_SESSION_COOKIE=          # instagramGeo.js / instagramLocations.js
LINKEDIN_COOKIE=                   # linkedinJpSearch.js (li_at session cookie)
PSN_NPSSO=                         # psnXboxJp.js (PSN npsso token)
XBOX_API_KEY=                      # psnXboxJp.js (OpenXBL key)
HOUMUKYOKU_API_KEY=                # houmukyokuCommercial.js (contracted records API)

# ── High-penetrancy deep-record collectors (native/collectors/sources/hp_*.c) ──
# The 300-row batch documented in
# native/collectors/OSINT_SOURCES_BATCH_300_HIGH_PENETRANCY.md. Most rows are
# keyless; these are the ones that are not. Every keyed row returns an honest
# empty (0 rows, a logged note) when its variable is unset — it never invents a
# record. Keys already defined earlier in this file are reused as-is
# (COMPANIES_HOUSE_API_KEY, UK_CHARITY_KEY, KVK_API_KEY, CRO_API_KEY,
# DART_API_KEY, ABR_GUID, INDIA_DATA_KEY, OPENSANCTIONS_API_KEY,
# COURTLISTENER_API_KEY, PATENTSVIEW_API_KEY, OPENCORPORATES_API_KEY,
# GITHUB_TOKEN, HIBP_API_KEY, OTX_API_KEY, GEONAMES_USER, FRED_KEY).
SAM_API_KEY=                       # SAM_GOV_ENTITY / SAM_OPPORTUNITIES (api.sam.gov, free signup)
FEC_API_KEY=                       # FEC_CONTRIBUTIONS (api.open.fec.gov; DEMO_KEY works for testing)
CSL_API_KEY=                       # US_CSL_SCREENING (data.trade.gov consolidated screening list)
GOVINFO_API_KEY=                   # US_GOVINFO_SEARCH (api.govinfo.gov, free signup)
BR_TRANSPARENCIA_KEY=              # BR_CEIS_SANCTIONS (portaldatransparencia.gov.br api key)
CL_MERCADOPUBLICO_TICKET=          # CL_MERCADO_PUBLICO (Chile Mercado Público ticket)
NZBN_ACCESS_TOKEN=                 # NZ_NZBN_SEARCH (api.business.govt.nz bearer token)
IATI_API_KEY=                      # IATI_ACTIVITIES (api.iatistandard.org subscription key)
GFW_API_TOKEN=                     # GFW_VESSEL_SEARCH (Global Fishing Watch bearer token)
AVIATIONSTACK_KEY=                 # AVIATIONSTACK_FLIGHT (aviationstack.com access key)

# ── Regional critical-values batch (native/collectors/sources/hp2_*.c) ─────────
# The 301-row Asia / South America / North America / Europe batch documented in
# native/collectors/OSINT_SOURCES_BATCH_300_CRITICAL_VALUES.md. Same contract as
# above: an unset variable means the row reports the missing credential and
# returns nothing — it never substitutes a fabricated record. SAM_API_KEY and
# BR_TRANSPARENCIA_KEY (declared above) are reused by rows in this batch.
KR_DATA_GO_KR_KEY=                 # KR_DATA_GO_KR (data.go.kr service key)
KR_ODCLOUD_KEY=                    # KR_NTS_BUSINESS_STATUS (odcloud.kr service key)
FMCSA_WEBKEY=                      # US_FMCSA_CARRIER (mobile.fmcsa.dot.gov webKey)
INPI_TOKEN=                        # FR_INPI_RNE (registre-national-entreprises.inpi.fr bearer)
INSEE_SIRENE_TOKEN=                # FR_SIRENE_ETABLISSEMENTS (api.insee.fr Sirene key)
OPEN_SUPPLY_HUB_TOKEN=             # OPEN_SUPPLY_HUB_FACILITIES (opensupplyhub.org API token)
