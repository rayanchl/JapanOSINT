/* core/collectors.def — display metadata for collector keys.
 *
 * `source_def.collector` is a MACHINE KEY: the beat a source was authored and
 * probed in (hpengine rows default to their table's file name; generated
 * feeds carry the beat the generator was run for; hand-written collectors
 * name their family). It is what groups sources in /api/collectors and the
 * web Collectors page. This table lays a human label, an optional Japanese
 * label, a one-line description and an optional PARENT key over it. A key
 * ABSENT from this table still renders — with the key itself as its label —
 * so a new beat is never hidden by not being listed here.
 *
 * PARENT is how "some sources sit alone in their collector, some are grouped"
 * is expressed without renaming anything: a child key keeps its identity (its
 * rows, its probe record), and the UI nests it under the parent. Every parent
 * is empty until someone decides a grouping; the census that informs that
 * decision is docs/source-pages-revamp/collector-census-2026-10-11.tsv.
 *
 *   COLLECTOR(key, label, label_ja, description, parent)
 *
 * Labels describe, they do not promise: "Japanese prefectural portals" says
 * what the beat set out to cover, not that every row is healthy today — the
 * per-collector tallies next to it are the measurement. */
COLLECTOR("osint",            "Hand-written OSINT pivots", "手書きOSINTピボット",
          "Entity-pivot collectors written by hand in collectors/sources/, plus the gnews-* news feeds.", NULL)
COLLECTOR("government",       "Government feeds", "政府・自治体フィード",
          "Scheduled feeds from national and municipal government sites.", NULL)
COLLECTOR("academic",         "Academic and research feeds", "学術・研究フィード", NULL, NULL)
COLLECTOR("science",          "Science feeds", "科学フィード", NULL, NULL)
COLLECTOR("europe_data",      "European open data", "欧州オープンデータ", NULL, NULL)
COLLECTOR("europe_news",      "European news", "欧州ニュース", NULL, NULL)
COLLECTOR("europe_env",       "European environment", "欧州環境", NULL, NULL)
COLLECTOR("europe_gov",       "European government", "欧州政府", NULL, NULL)
COLLECTOR("fr_opendata",      "France — open data", "フランス オープンデータ", NULL, NULL)
COLLECTOR("fr_prefectural",   "France — prefectures", "フランス 県", NULL, NULL)
COLLECTOR("de_opendata",      "Germany — open data", "ドイツ オープンデータ", NULL, NULL)
