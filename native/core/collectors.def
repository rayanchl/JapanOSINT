COLLECTOR("disaster",         "Disaster and hazard", "災害・ハザード", NULL, NULL)
COLLECTOR("environment",      "Environment", "環境", NULL, NULL)
COLLECTOR("earthobs",         "Earth observation", "地球観測", NULL, NULL)
