/* core/host_agents.def — THE per-host User-Agent table: one line per host whose
 * server refuses the engine's default agent (JO_USER_AGENT), naming the agent
 * that host gets instead. Included by core/httpclient.c (the engine) and read
 * by tools/probe_hp_batch.py (the probe), so both send the same thing;
 * `./bin/japanosint --host-agents` prints it.
 *
 * PRECEDENCE: for a host listed here the table's agent goes on the wire,
 * whatever User-Agent a row or a collector set — one rule everywhere. A host
 * not listed keeps the row's own header if it declared one, else JO_USER_AGENT.
 *
 * Admit a host only after bisecting it, cheapest change first: the engine
 * agent; HA_NOCOLLECTOR (the same agent minus the word "collector");
 * HA_CONTACT (minus the contact URL); HA_COMPAT (a browser-compatible prefix,
 * still naming us); HA_BROWSER only when every agent naming us is refused —
 * the repository owner's decision of 2026-10-21. Keep the measurement beside
 * the entry.
 *
 * Until 2026-10-21 this was three mechanisms with three precedences: the
 * UA_OVERRIDE and BROWSER_HOSTS tables in httpclient.c, and 471 per-row
 * `.headers` on 320 hosts (batches 44-48). The per-row header beat
 * UA_OVERRIDE; BROWSER_HOSTS beat both. Measured before the move: no other
 * source fetches from those 320 hosts, so the wire did not change.
 * midjourneyvideo.net was dropped in the move: a gambling site squatting on a
 * city's lapsed domain, whose row had been rejected as a takeover. */

/* The agents. HA_BROWSER also gets BROWSER_EXTRA_HEADERS (httpclient.c). */
HOST_AGENT_KIND(HA_NOCOLLECTOR, "JapanOSINT/1.0 (+https://github.com/RCorp/OSINTsaas; contact via repo issues)")
HOST_AGENT_KIND(HA_CONTACT,     "JapanOSINT/1.0 (contact via repo issues)")
HOST_AGENT_KIND(HA_RCORP,       "RCorp-feeds/1.0 (+https://github.com/RCorp; feed collector; contact via repo issues)")
HOST_AGENT_KIND(HA_COMPAT,      "Mozilla/5.0 (compatible; JapanOSINT/1.0; +https://github.com/rayanchl/JapanOSINT)")
HOST_AGENT_KIND(HA_BROWSER,     "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36")

/* ── token and contact-URL blocks (was UA_OVERRIDE) ────────────────────── */
  HOST_AGENT("data.humdata.org", HA_RCORP)
  /* Same token block as HDX. Measured 2026-08-24:
   *     engine UA (contains "OSINT")  520
   *     the agent below                200
   *     no User-Agent at all           200
   * We still identify ourselves and still offer a contact route, so this is
   * the documented remedy rather than an evasion. */
  HOST_AGENT("www.oasis-open.org", HA_CONTACT)
  /* Spain's INE web service (servicios.ine.es/wstempus). Measured 2026-09-07
   * against /wstempus/js/ES/CLASIFICACIONES:
   *     engine UA                                                403
   *     "JapanOSINT/1.0"                                         200
   *     "JapanOSINT/1.0 (+https://github.com/RCorp/OSINTsaas)"   200
   *     "JapanOSINT/1.0 (contact via repo issues)"               200
   *     "JapanOSINT/1.0 (feed collector)"                        403
   *     the RCorp-feeds agent above                              403
   * The rejected token is the word "collector", not "OSINT" — which is why
   * the two agents already in this table do not help. The agent below is the
   * engine's own, with that one word removed: it still names the product,
   * still gives the repository and still offers a contact route. All eleven
   * eur-ine-* sources were storing nothing on every scheduled run; with this
   * agent CLASIFICACIONES, ESCALAS, PERIODICIDADES, UNIDADES, VARIABLES,
   * PUBLICACIONES, OPERACIONES_DISPONIBLES and TABLAS_OPERACION/{EPA,IPC,IPRI}
   * all answer 200 with real records. */
  HOST_AGENT("servicios.ine.es", HA_NOCOLLECTOR)

  /* Boston's CKAN portal, behind the same class of filter. Bisected
   * 2026-09-11 against data.boston.gov/api/3/action/package_search:
   *     "JapanOSINT/1.0"                                         200
   *     "JapanOSINT/1.0 (… feed)"                                200
   *     "JapanOSINT/1.0 (… collector)"                           502
   *     the full engine UA                                       502
   * So it is the word "collector" again, exactly as at INE, and the same
   * agent clears it — verified on package_search, group_list,
   * organization_list, tag_list, recently_changed_packages_activity_list and
   * the per-organization `fq=organization:…` searches, which also honour the
   * filter (9 of 235 packages for one org, so rule 4d is satisfied). 35
   * registered us-data-boston-gov-* sources were storing nothing on every
   * scheduled run. */
  HOST_AGENT("data.boston.gov", HA_NOCOLLECTOR)

  /* India's Press Information Bureau. Here the rejected token is the contact
   * URL itself, not a word in the product name. Measured 2026-09-11 on
   * pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3 (following its 302):
   *     "JapanOSINT/1.0"                                       200, 20 items
   *     "JapanOSINT/1.0 (contact via repo issues)"             200, 20 items
   *     the feed agent carrying "(+https://github.com/…)"      403
   * The agent below therefore keeps BOTH the product identity and a contact
   * route, and drops only the URL its filter refuses. Note this is the RSS
   * path, which sets its own User-Agent header: it reaches this table through
   * http_ua_override(), not through CURLOPT_USERAGENT. */
  HOST_AGENT("pib.gov.in", HA_CONTACT)

  /* Camden County, NJ: the contact URL is the refused token, as at PIB.
   * Measured 2026-10-21 on www.camdencounty.com/feed/:
   *     the full engine UA                                       403
   *     "JapanOSINT/1.0 (+https://github.com/RCorp/OSINTsaas)"   403
   *     "JapanOSINT/1.0 (contact via repo issues)"               200, 10 items
   *     "JapanOSINT/1.0"                                          200
   * us-b50-camdencounty-com was rejected in batch 50 for this until the
   * retry pass bisected it. */
  HOST_AGENT("www.camdencounty.com", HA_CONTACT)

  /* The "collector" word filter again, on four more hosts. Measured 2026-09-14
   * by comparing the engine agent against the same agent with that one word
   * removed (the INE / Boston agent above):
   *     data.sanjoseca.gov (OpenGov CKAN)   502 -> 200   15 us-data-sanjoseca-gov-* rows
   *     www.madamasr.com   (RSS)            520 -> 200   afr-eg-madamasr
   *     www.telegram.hr    (RSS)            520 -> 200   eur-news-telegram-hr
   *     www.jornalnoticias.co.mz (RSS)      406 -> 200   afr-mz-jornalnoticias
   * Every one of those sources was storing nothing on every scheduled run. The
   * agent still names the product, the repository and a contact route. */
  HOST_AGENT("data.sanjoseca.gov", HA_NOCOLLECTOR)
  HOST_AGENT("www.madamasr.com", HA_NOCOLLECTOR)
  HOST_AGENT("www.telegram.hr", HA_NOCOLLECTOR)
  HOST_AGENT("www.jornalnoticias.co.mz", HA_NOCOLLECTOR)

  /* SIX MORE, and the "collector" filter now looks like a FAMILY rather than a
   * run of coincidences. Bisected 2026-10-20 against each host's own
   * /api/3/action/package_search?rows=1:
   *
   *     host                   engine UA   without "collector"   bare
   *     data.ok.gov              502            200               200
   *     data.virginia.gov        502            200               200
   *     opendata.hawaii.gov      502            200               200
   *     data.houstontx.gov       502            200               200
   *     data.milwaukee.gov       502            200               200
   *     data.sanantonio.gov      502            200               200
   *
   * Six for six, the same status and the same single word as data.boston.gov
   * and data.sanjoseca.gov above — two OpenGov-hosted CKAN portals, which these
   * six also are. So a 502 from a US municipal CKAN is worth bisecting the
   * agent on BEFORE it is read as a dead endpoint or as load.
   *
   * How they were found is the part worth keeping. The batch-34 emit audit
   * reported all six FETCH_FAILED at three parallel jobs, and this tree's own
   * rule ("a verdict that changes with --jobs is not a measurement") said to
   * re-run them serially. They failed again, serially — which ruled concurrency
   * OUT and left the client as the only difference, since the same URLs answer
   * 200 in half a second to a hand request.
   *
   * AND THE TREE ALREADY KNEW, one row at a time. Each of these six hosts
   * carries a second registered row from an earlier batch — five JO29A_FGT_*
   * and SOCRATA_HAWAII — and every one of them carried a per-ROW
   * `User-Agent: JapanOSINT/1.0` header, which is why those six store records
   * today (data.ok.gov: 397, its whole package_search count; San Antonio 166,
   * Milwaukee 186, Houston 96). So an earlier session met this same filter on
   * these same hosts and solved it in the row rather than in a table, and
   * batch 34 could not inherit what was written there. A host-level entry
   * fixes every row on the host, including the next one somebody adds — which
   * is this file's whole argument, reached independently. */
  HOST_AGENT("data.ok.gov", HA_NOCOLLECTOR)
  HOST_AGENT("data.virginia.gov", HA_NOCOLLECTOR)
  HOST_AGENT("opendata.hawaii.gov", HA_NOCOLLECTOR)
  HOST_AGENT("data.houstontx.gov", HA_NOCOLLECTOR)
  HOST_AGENT("data.milwaukee.gov", HA_NOCOLLECTOR)
  HOST_AGENT("data.sanantonio.gov", HA_NOCOLLECTOR)

  /* planelogger.com, found by re-asking batch 31's twice-refused rows what they
   * actually answer rather than removing them under "fails twice leaves".
   * Measured 2026-10-20 on /Aircraft/Search?searchterm=Toyota, twice each:
   *     engine UA        403, 403
   *     HA_NOCOLLECTOR   200, 200  (19,742 bytes, the aircraft table)
   *     "JapanOSINT/1.0" 200, 200
   * so it is the word filter again, and OFFSHORE_AIRCRAFT_REGISTRIES was one
   * table entry away from working rather than dead. Worth noting what the
   * triage that found it ALSO found: of the other 89 rows, 36 answer 403 at the
   * host ROOT as well as on the path, which no agent naming us clears — a
   * wall, not a word filter. This entry is the one row where the bisection
   * changed the answer, which is the measurement being worth making and not a
   * reason to expect it often. */
  HOST_AGENT("www.planelogger.com", HA_NOCOLLECTOR)

  /* OCHA Financial Tracking Service (api.hpc.tools) — the HDX "OSINT" token
   * block, same operator family. Measured 2026-09-14: engine agent 406, the
   * RCorp-feeds agent HDX already uses 200. Four ocha-fts-* rows. */
  HOST_AGENT("api.hpc.tools", HA_RCORP)

  /* Seven more, bisected with libcurl on 2026-09-15 (engine agent → the agent
   * below; statuses as measured):
   *   reliefweb.int      406 "Blocked" (also without "collector", also bare
   *                      JapanOSINT/1.0)            → RCorp-feeds 200, 66 KB RSS
   *   www.unocha.org     406 for any agent containing "OSINT"
   *                                                 → RCorp-feeds 301→200, 10 items
   *   hapi.humdata.org   406 "Blocked due to bot activity" (HDX's API host)
   *                                                 → RCorp-feeds 200, 33 KB records
   *   jamestown.org      403, also without "collector" or the repo URL
   *                                                 → RCorp-feeds 200, 10 items
   *   www.bsi.bund.de    403 (5 feeds) — the word "collector"
   *                                                 → engine agent minus it 200, 50 items
   *   container-news.com 403 — the word "collector" → same agent 200, 88 KB
   *   www.ftc.gov        403 for every agent carrying a github URL
   *                                                 → product + contact route 200, 10 items
   * Same remedy as the entries above: each agent still names the client and a
   * contact route and drops only the token the filter rejects. Hosts that
   * refused EVERY agent (Europarl 202-empty, Tel Aviv GIS 571, CISA/FEMA/ICE
   * fingerprinting libcurl itself) are deliberately NOT listed. */
  HOST_AGENT("reliefweb.int", HA_RCORP)
  HOST_AGENT("www.unocha.org", HA_RCORP)
  HOST_AGENT("hapi.humdata.org", HA_RCORP)
  HOST_AGENT("jamestown.org", HA_RCORP)
  HOST_AGENT("www.bsi.bund.de", HA_NOCOLLECTOR)
  HOST_AGENT("container-news.com", HA_NOCOLLECTOR)
  HOST_AGENT("www.ftc.gov", HA_CONTACT)
  /* The "collector" word filter once more (decided 2026-10-09 to route
   * around it). Measured against /en/bycountry/JP/:
   *     engine UA                                              403, 153 B
   *     "RCorp-feeds/1.0 (…; feed collector; …)"               403
   *     "JapanOSINT/1.0 (+https://github.com/RCorp/OSINTsaas;
   *      contact via repo issues)"                             200, 19,850 B
   * cam-insecam-scrape had failed every run since 2026-10-06 on the 403. */
  HOST_AGENT("www.insecam.org", HA_NOCOLLECTOR)

  /* INGV's FDSN event service, the same one-word filter. Measured 2026-10-06
   * against fdsnws/event/1/query?format=geojson:
   *     "JapanOSINT/1.0"                                         200
   *     "JapanOSINT/1.0 (+https://github.com/RCorp/OSINTsaas)"   200
   *     "JapanOSINT/1.0 (feed collector)"                        connection dropped
   *     the full engine UA                                       connection dropped
   *     the agent below                                          200 (61 KB)
   * geo-ingv-events-30d and geo-italy-ingv-last100 failed every run with
   * "fetch failed" — before and after their date windows were rolled. */
  HOST_AGENT("webservices.ingv.it", HA_NOCOLLECTOR)

  /* Batch 50: the same "collector" word filter, on 48 more hosts — mostly French
   * commune sites (WordPress behind one nginx bot rule, answering 444/403) and
   * small US city sites. Bisected 2026-10-20 per host, on the registered feed URL:
   *     the full engine UA                                       403 / 444 / 0 items
   *     "JapanOSINT/1.0 (collector)"                           403 / 444
   *     "JapanOSINT/1.0 (contact via repo issues)"             200 + items
   *     the agent below                                          200 + items
   * 88 batch-50 rows (authored as 45) stored nothing on the emit sweep until this. Hosts that
   * refused EVERY honest agent (only a browser string passed) were not added
   * here and their rows were not shipped: docs/rejected-sources-batch50.tsv. */
  /* edinburgnd.com: added 2026-10-21 by the retry pass: engine UA 403, this agent 200 */
  HOST_AGENT("edinburgnd.com", HA_NOCOLLECTOR)
